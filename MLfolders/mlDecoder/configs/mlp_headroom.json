{
  "backend": "mlp",
  "description": "HEADROOM run (separate from the grid): the d=3, R=10, Z, leakage p=0.001 MLP of mlp_full, retrained with a 600 s time budget instead of 50 s. Same seed, pool, validation set and frozen test shots, so the budget is the only change.",
  "grid": {
    "distance": 3,
    "rounds": 10,
    "basis": "Z",
    "noise": "leakage",
    "p": 0.001,
    "gate_basis": "cz",
    "no_reset": true
  },
  "device": "cuda",
  "seed": 1234,
  "max_total_train_seconds": 2700,
  "model": {
    "hidden_layers": 3,
    "width_factor": 6,
    "min_width": 128,
    "by_distance": {
      "5": {
        "width_factor": 4
      },
      "7": {
        "width_factor": 4
      }
    }
  },
  "train": {
    "batch_size": 16384,
    "lr": 0.002,
    "warmup_fraction": 0.03,
    "final_lr_fraction": 0.02,
    "weight_decay": 0.0001,
    "max_train_shots": 2000000000,
    "anneal_by_time": true,
    "time_budget_seconds": 600,
    "max_wall_seconds": 2700,
    "eval_every_steps": 1000000,
    "eval_every_seconds": 20,
    "patience_evals": 10,
    "min_progress_to_stop": 0.5,
    "checkpoint_seconds": 60,
    "amp": true,
    "drop_trivial": true,
    "val_shots": 200000,
    "leakage_val_shots": 50000,
    "leakage_pool_shots": 2000000
  },
  "test": {
    "target_failures": 100,
    "safety": 1.25,
    "max_shots": 10000000,
    "min_shots": 100000,
    "min_shots_leakage": 100000,
    "pilot_target_failures": 30,
    "pilot_max_shots": 2000000,
    "pilot_max_shots_leakage": 200000
  },
  "eval": {
    "batch_sizes": [
      1,
      64,
      4096,
      65536
    ],
    "min_seconds": 0.2,
    "max_cpu_call_seconds": 4,
    "benchmark": false
  },
  "workers": 4
}